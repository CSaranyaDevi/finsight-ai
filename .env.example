# Copy to .env and fill in. Never commit .env.
# On Replit, set these same names in Secrets instead.

# --- OpenAI ---
OPENAI_API_KEY=

# --- Models ---
EMBEDDING_MODEL=text-embedding-3-small
# Index vectors. 1536 for text-embedding-3-small; text-embedding-3-large is 3072 native (or shorten, e.g. 1536).
# Changing either requires rebuilding the index (notebook 03).
EMBEDDING_DIM=1536
# Semantic chunk boundaries (kept separate so the chunk sets stay comparable)
CHUNKER_EMBEDDING_MODEL=text-embedding-3-small
# Chat models per role
ANALYSIS_MODEL=gpt-4.1
ANSWER_MODEL=gpt-5.4
# OpenAI has no reranker. Options: llm (rerank with a chat model) or local (bge cross-encoder)
RERANK_BACKEND=llm
RERANK_MODEL=gpt-4.1-mini

# --- Paths ---
INDEX_DIR=./index
DATA_DIR=./DataSource

# --- Optional: LangSmith tracing ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finsight-ai
